{
	"name": "website-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && panda codegen",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"check:fix": "prettier --write . && eslint --fix ."
	},
	"devDependencies": {
		"@chakra-ui/panda-preset": "^3.34.0",
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@pandacss/dev": "^1.9.0",
		"@pandacss/eslint-plugin": "^0.3.2",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/enhanced-img": "^0.10.4",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^25.5.0",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^17.4.0",
		"jiti": "^2.6.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.5",
		"svelte-meta-tags": "^4.5.0",
		"svelte-render-scan": "^1.1.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.1",
		"vite": "^8.0.1"
	},
	"dependencies": {
		"@ark-ui/svelte": "^5.19.1",
		"@date-fns/tz": "^1.4.1",
		"@lucide/svelte": "^0.577.0",
		"date-fns": "^4.1.0",
		"feed": "^5.2.0",
		"http-status-codes": "^2.3.0",
		"kiso.css": "^1.2.4",
		"license-report": "^6.8.2",
		"microcms-js-sdk": "^3.3.0",
		"node-html-parser": "^7.1.0",
		"svelte-themes": "^2.0.10",
		"tslog": "^4.10.2",
		"zod": "^4.3.6"
	}
}
